# Check for LD_LIBRARY_PATH being set, which can break SDK and generally is a bad practice
# http://tldp.org/HOWTO/Program-Library-HOWTO/shared-libraries.html#AEN80
# http://xahlee.info/UnixResource_dir/_/ldpath.html
# Only disable this check if you are absolutely know what you are doing!
if [ ! -z "${LD_LIBRARY_PATH:-}" ]; then
    echo "Your environment is misconfigured, you probably need to 'unset LD_LIBRARY_PATH'"
    echo "but please check why this was set in the first place and that it's safe to unset."
    echo "The SDK will not operate correctly in most cases when LD_LIBRARY_PATH is set."
    echo "For more references see:"
    echo "  http://tldp.org/HOWTO/Program-Library-HOWTO/shared-libraries.html#AEN80"
    echo "  http://xahlee.info/UnixResource_dir/_/ldpath.html"
    return 1
fi

export SDKTARGETSYSROOT=/home/dsh/Desktop/qcom_sdk/tmp/sysroots/qcom-armv8a
export PATH=/home/dsh/Desktop/qcom_sdk/tmp/sysroots/x86_64/usr/bin:/home/dsh/Desktop/qcom_sdk/tmp/sysroots/x86_64/usr/sbin:/home/dsh/Desktop/qcom_sdk/tmp/sysroots/x86_64/bin:/home/dsh/Desktop/qcom_sdk/tmp/sysroots/x86_64/sbin:/home/dsh/Desktop/qcom_sdk/tmp/sysroots/x86_64/usr/bin/../x86_64-qcomsdk-linux/bin:/home/dsh/Desktop/qcom_sdk/tmp/sysroots/x86_64/usr/bin/aarch64-qcom-linux:/home/dsh/Desktop/qcom_sdk/tmp/sysroots/x86_64/usr/bin/aarch64-qcom-linux-musl:"$PATH"
export PKG_CONFIG_SYSROOT_DIR=$SDKTARGETSYSROOT
export PKG_CONFIG_PATH=$SDKTARGETSYSROOT/usr/lib/pkgconfig:$SDKTARGETSYSROOT/usr/share/pkgconfig
export CONFIG_SITE=/home/dsh/Desktop/qcom_sdk/site-config-armv8a-qcom-linux
export OECORE_NATIVE_SYSROOT="/home/dsh/Desktop/qcom_sdk/tmp/sysroots/x86_64"
export OECORE_TARGET_SYSROOT="$SDKTARGETSYSROOT"
export OECORE_ACLOCAL_OPTS="-I /home/dsh/Desktop/qcom_sdk/tmp/sysroots/x86_64/usr/share/aclocal"
export OECORE_BASELIB="lib"
export OECORE_TARGET_ARCH="aarch64"
export OECORE_TARGET_OS="linux"
export OECORE_TARGET_BITS="64"
export OECORE_TARGET_ENDIAN="little"
export OECORE_MESON_HOST_SYSTEM="linux"
export OECORE_MESON_HOST_CPU_FAMILY="aarch64"
export OECORE_MESON_HOST_CPU="aarch64"
export OECORE_MESON_HOST_ENDIAN="little"
unset command_not_found_handle
export CC="aarch64-qcom-linux-gcc  -march=armv8-a+crc -mbranch-protection=standard -fstack-protector-strong  -O2 -D_FORTIFY_SOURCE=2 -Wformat -Wformat-security -Werror=format-security --sysroot=$SDKTARGETSYSROOT"
export CXX="aarch64-qcom-linux-g++  -march=armv8-a+crc -mbranch-protection=standard -fstack-protector-strong  -O2 -D_FORTIFY_SOURCE=2 -Wformat -Wformat-security -Werror=format-security --sysroot=$SDKTARGETSYSROOT"
export CPP="aarch64-qcom-linux-gcc -E  -march=armv8-a+crc -mbranch-protection=standard -fstack-protector-strong  -O2 -D_FORTIFY_SOURCE=2 -Wformat -Wformat-security -Werror=format-security --sysroot=$SDKTARGETSYSROOT"
export AS="aarch64-qcom-linux-as "
export LD="aarch64-qcom-linux-ld  --sysroot=$SDKTARGETSYSROOT"
export GDB=aarch64-qcom-linux-gdb
export STRIP=aarch64-qcom-linux-strip
export RANLIB=aarch64-qcom-linux-ranlib
export OBJCOPY=aarch64-qcom-linux-objcopy
export OBJDUMP=aarch64-qcom-linux-objdump
export READELF=aarch64-qcom-linux-readelf
export AR=aarch64-qcom-linux-ar
export NM=aarch64-qcom-linux-nm
export M4=m4
export TARGET_PREFIX=aarch64-qcom-linux-
export CONFIGURE_FLAGS="--target=aarch64-qcom-linux --host=aarch64-qcom-linux --build=x86_64-linux --with-libtool-sysroot=$SDKTARGETSYSROOT"
export CFLAGS=" -O2 -g  -pipe"
export CXXFLAGS=" -O2 -g  -pipe"
export LDFLAGS="-Wl,-O1 -Wl,--hash-style=gnu -Wl,--as-needed -Wl,-z,relro,-z,now"
export CPPFLAGS=""
export KCFLAGS="--sysroot=$SDKTARGETSYSROOT"
export OECORE_DISTRO_VERSION="2.0"
export OECORE_SDK_VERSION="2.0"
export ARCH=arm64
export CROSS_COMPILE=aarch64-qcom-linux-
export OECORE_TUNE_CCARGS=" -march=armv8-a+crc -mbranch-protection=standard"

# Append environment subscripts
if [ -d "$OECORE_TARGET_SYSROOT/environment-setup.d" ]; then
    for envfile in $OECORE_TARGET_SYSROOT/environment-setup.d/*.sh; do
	    . $envfile
    done
fi
if [ -d "$OECORE_NATIVE_SYSROOT/environment-setup.d" ]; then
    for envfile in $OECORE_NATIVE_SYSROOT/environment-setup.d/*.sh; do
	    . $envfile
    done
fi
# Save and reset OECORE_NATIVE_SYSROOT as buildtools may change it
SAVED="$OECORE_NATIVE_SYSROOT"
. /home/dsh/Desktop/qcom_sdk/buildtools/environment-setup*
export OECORE_NATIVE_SYSROOT="$SAVED"
export OE_SKIP_SDK_CHECK=1
export DEPLOY_DIR_IMAGE=/home/dsh/Desktop/qcom_sdk/tmp/deploy/images/qcom-armv8a
export PATH="/home/dsh/Desktop/qcom_sdk/layers/oe-core/scripts/esdk-tools:$PATH"
printf 'SDK environment now set up; additionally you may now run devtool to perform development tasks.
Run devtool --help for further details.
'
