#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Prepare host-side bounded raw corpora and independent decoder fixtures."""
import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import importlib.machinery
import importlib.util


def sha(path):
    h = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            h.update(block)
    return h.hexdigest()


def run(command, log):
    with log.open('w') as output:
        subprocess.run(command, stdout=output, stderr=subprocess.STDOUT, check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--width', type=int, default=1920)
    parser.add_argument('--height', type=int, default=1080)
    parser.add_argument('--fps', default='60')
    parser.add_argument('--frames', type=int, default=120)
    parser.add_argument('--natural-source', type=Path)
    parser.add_argument('--provenance', type=Path)
    parser.add_argument('--decoder-matrix', action='store_true')
    parser.add_argument('--decode-fixtures', action='store_true')
    args = parser.parse_args()
    args.output.mkdir(parents=True, exist_ok=False)
    if args.width % 2 or args.height % 2 or min(args.width, args.height, args.frames) <= 0:
        parser.error('Positive even dimensions and positive frame count required')
    if args.decoder_matrix:
        for w, h in ((640, 480), (1280, 720), (1920, 1080), (2560, 1440), (3840, 2160), (4096, 4096)):
            for fps in (24, 30, 60, 120):
                path = args.output / f'{w}x{h}-{fps}.h265'
                command = ['ffmpeg', '-nostdin', '-v', 'error', '-f', 'lavfi', '-i',
                           f'testsrc2=size={w}x{h}:rate={fps}', '-frames:v', '60', '-pix_fmt', 'yuv420p',
                           '-c:v', 'libx265', '-preset', 'ultrafast', '-x265-params',
                           'keyint=60:bframes=0:open-gop=0:repeat-headers=1:aud=1:pools=2:frame-threads=2',
                           '-crf', '26', '-f', 'hevc', str(path)]
                run(command, path.with_suffix('.log'))
                subprocess.run(['python3', str(Path(__file__).with_name('analyze-quality')), '--index', str(path)], check=True)
                path.with_suffix('.command.json').write_text(json.dumps(command) + '\n')
        return
    if not args.natural_source or not args.provenance:
        parser.error('--natural-source and --provenance are required for raw corpora')
    shape = f'{args.width}x{args.height}'
    entries = []
    for kind in ('motion', 'texture', 'cuts', 'natural'):
        path = args.output / (kind + '.nv12')
        command = ['ffmpeg', '-nostdin', '-v', 'error', '-threads', '2', '-filter_threads', '2']
        filters = []
        if kind == 'natural':
            command += ['-i', str(args.natural_source.resolve())]
            # Keep source frames; no repeated/interpolated frames to claim native cadence.
            filters += [f'scale={args.width}:{args.height}:out_color_matrix=bt709:out_range=tv']
        else:
            command += ['-f', 'lavfi', '-i', f'testsrc2=size={shape}:rate={args.fps}']
            if kind == 'texture':
                filters += ['noise=alls=45:all_seed=7:allf=t+u']
            elif kind == 'cuts':
                filters += ["negate=enable='gte(mod(n,60),30)'"]
        filters += ['format=nv12']
        command += ['-vf', ','.join(filters), '-frames:v', str(args.frames),
                    '-fps_mode', 'passthrough', '-an', '-f', 'rawvideo', str(path)]
        run(command, args.output / (kind + '.log'))
        if path.stat().st_size != args.width * args.height * 3 // 2 * args.frames:
            raise RuntimeError('Input source is shorter than the required corpus')
        entries.append(dict(kind=kind, path=path.name, sha256=sha(path), command=command,
                            width=args.width, height=args.height, fps=args.fps, frames=args.frames,
                            temporal_policy='original successive frames, replay at requested fps' if kind == 'natural' else 'generated at requested fps'))
    manifest = dict(schema_version=1, entries=entries, provenance=json.loads(args.provenance.read_text()),
                    natural_source_sha256=sha(args.natural_source),
                    ffmpeg_version=subprocess.check_output(['ffmpeg', '-version'], text=True).splitlines()[0])
    (args.output / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    if args.decode_fixtures:
        loader = importlib.machinery.SourceFileLoader('quality', str(Path(__file__).with_name('analyze-quality')))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        quality = importlib.util.module_from_spec(spec); loader.exec_module(quality)
        for profile, params, pixel in [('intra', 'keyint=1:bframes=0', 'yuv420p'),
                                       ('ip', 'keyint=60:bframes=0', 'yuv420p'),
                                       ('b', 'keyint=60:bframes=3', 'yuv420p'),
                                       ('main10', 'keyint=60:bframes=3', 'yuv420p10le')]:
            path = args.output / (profile + '.h265')
            command = ['ffmpeg', '-nostdin', '-v', 'error', '-f', 'rawvideo', '-pixel_format', 'nv12',
                       '-video_size', shape, '-framerate', args.fps, '-i', str(args.output / 'motion.nv12'),
                       '-filter_threads', '2', '-pix_fmt', pixel, '-c:v', 'libx265', '-preset', 'fast',
                       '-x265-params', params + ':pools=2:frame-threads=2:open-gop=0:repeat-headers=1:aud=1',
                       '-crf', '24', '-f', 'hevc', str(path)]
            run(command, args.output / (profile + '.log'))
            quality.index_stream(path)
            (args.output / (profile + '.command.json')).write_text(json.dumps(command) + '\n')


if __name__ == '__main__':
    main()
