#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Run a bounded command in monitor mode, then restore NetworkManager state."""
import argparse
import json
import os
import re
import shlex
import signal
import subprocess
import time
from pathlib import Path


def run(argv):
    result = subprocess.run(argv, text=True, capture_output=True, timeout=30)
    if result.returncode:
        raise RuntimeError(f"{argv!r}: {result.stderr.strip()}")
    return result.stdout.strip()


def execute_command(command):
    process = subprocess.Popen(command, start_new_session=True)
    try:
        return process.wait(timeout=1860)
    except BaseException:
        # Stop TX before restoring the interface, including cancellation/timeouts.
        if process.poll() is None:
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
        raise


def restore_connection(interface, uuid, invoke=run, clock=time.monotonic,
                       pause=time.sleep):
    deadline = clock() + 30
    while True:
        try:
            invoke(["nmcli", "connection", "up", "uuid", uuid, "ifname", interface])
            return
        except RuntimeError as error:
            transient = any(text in str(error).lower()
                            for text in ("unmanaged", "not available", "not found"))
            if not transient or clock() >= deadline:
                raise
            pause(0.5)


def wait_unmanaged(interface, invoke=run, clock=time.monotonic, pause=time.sleep):
    deadline = clock() + 10
    while clock() < deadline:
        state = invoke(["nmcli", "-g", "GENERAL.STATE", "device", "show", interface])
        if state.split()[0:1] == ["10"]:
            return
        pause(0.1)
    raise RuntimeError("NetworkManager did not finish unmanaging the target device")


def supplicant_interface(interface, invoke=run):
    fields = shlex.split(invoke(["busctl", "--system", "--timeout=2", "call",
        "fi.w1.wpa_supplicant1", "/fi/w1/wpa_supplicant1",
        "fi.w1.wpa_supplicant1", "GetInterface", "s", interface]))
    if len(fields) != 2 or fields[0] != "o" or not fields[1].startswith(
            "/fi/w1/wpa_supplicant1/Interfaces/"):
        raise RuntimeError("unexpected supplicant interface response")
    return fields[1]


def wait_supplicant_removed(path, invoke=run, clock=time.monotonic, pause=time.sleep):
    deadline = clock() + 10
    while clock() < deadline:
        fields = shlex.split(invoke(["busctl", "--system", "--timeout=2",
            "get-property", "fi.w1.wpa_supplicant1", "/fi/w1/wpa_supplicant1",
            "fi.w1.wpa_supplicant1", "Interfaces"]))
        if len(fields) < 2 or fields[0] != "ao" or not fields[1].isdigit() or int(fields[1]) != len(fields) - 2:
            raise RuntimeError("unexpected supplicant interface list")
        if path not in fields[2:]:
            return
        pause(0.1)
    raise RuntimeError("supplicant did not release the target interface")


def with_monitor(interface, frequency, command, invoke=run, execute=execute_command):
    # Require a managed AIC interface. Do not stop NetworkManager globally.
    if "type managed" not in invoke(["iw", "dev", interface, "info"]):
        raise RuntimeError("expected managed interface; refusing to change an unknown prior mode")
    if invoke(["nmcli", "-g", "GENERAL.NM-MANAGED", "device", "show", interface]) != "yes":
        raise RuntimeError("interface must be managed by NetworkManager before this trial")
    uuid = invoke(["nmcli", "-g", "GENERAL.CON-UUID", "device", "show", interface])
    supplicant = supplicant_interface(interface, invoke) if uuid and uuid != "--" else None
    p2p = "p2p-dev-" + interface
    devices = invoke(["nmcli", "-t", "-f", "DEVICE,TYPE", "device", "status"])
    p2p_managed = False
    if p2p + ":wifi-p2p" in devices.splitlines():
        p2p_managed = invoke(["nmcli", "-g", "GENERAL.NM-MANAGED", "device", "show", p2p]) == "yes"
        if p2p_managed and invoke(["nmcli", "-g", "GENERAL.STATE", "device", "show", p2p]).split()[0:1] != ["30"]:
            raise RuntimeError("target P2P device must be idle before a monitor trial")
    failures = []
    trial_error = None
    p2p_changed = False
    try:
        if p2p_managed:
            # The same radio's idle P2P device can keep the supplicant alive.
            # Preserve its policy and never touch another adapter's P2P device.
            p2p_changed = True
            invoke(["nmcli", "device", "set", p2p, "managed", "no"])
            wait_unmanaged(p2p, invoke)
        if uuid and uuid != "--":
            # Wait for the supplicant connection to finish deactivating before
            # changing type. Otherwise its teardown can reset monitor to managed.
            invoke(["nmcli", "--wait", "10", "device", "disconnect", interface])
        invoke(["nmcli", "device", "set", interface, "managed", "no"])
        wait_unmanaged(interface, invoke)
        if supplicant:
            wait_supplicant_removed(supplicant, invoke)
        invoke(["ip", "link", "set", interface, "down"])
        invoke(["iw", "dev", interface, "set", "type", "monitor"])
        invoke(["ip", "link", "set", interface, "up"])
        invoke(["iw", "dev", interface, "set", "freq", str(frequency), "HT20"])
        actual = invoke(["iw", "dev", interface, "info"])
        if "type monitor" not in actual or not re.search(
                r"channel\s+\d+\s+\(" + str(frequency) + r" MHz\), width: 20 MHz", actual):
            raise RuntimeError("monitor mode/channel readback does not match the requested HT20 trial")
        return execute(command)
    except BaseException as error:
        trial_error = error
        raise
    finally:
        # Attempt every restoration step even if an earlier one fails.
        restore = [["ip", "link", "set", interface, "down"],
                   ["iw", "dev", interface, "set", "type", "managed"],
                   ["ip", "link", "set", interface, "up"],
                   ["nmcli", "device", "set", interface, "managed", "yes"]]
        for argv in restore:
            try:
                invoke(argv)
            except Exception as error:
                failures.append(str(error))
        if uuid and uuid != "--":
            try:
                restore_connection(interface, uuid, invoke)
            except Exception as error:
                failures.append(str(error))
        if p2p_changed:
            try:
                invoke(["nmcli", "device", "set", p2p, "managed", "yes"])
            except Exception as error:
                failures.append(str(error))
        if failures:
            detail = ("trial failed: " + str(trial_error) + "; " if trial_error else "")
            raise RuntimeError(detail + "network restoration failed: " + "; ".join(failures)) from trial_error


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--interface", default="wlan0")
    parser.add_argument("--frequency", type=int, default=5180)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if not re.fullmatch(r"[A-Za-z0-9_.:-]{1,15}", args.interface):
        parser.error("invalid interface name")
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        parser.error("provide a command after --")
    if os.geteuid() != 0:
        parser.error("root is required")
    model = Path("/sys/firmware/devicetree/base/model").read_text().strip("\x00\n")
    device = Path(f"/sys/class/net/{args.interface}/device")
    if model != "Radxa Dragon Q6A" or (device / "idVendor").read_text().strip() != "a69c" or (device / "idProduct").read_text().strip() != "8d81":
        parser.error("only the verified Q6A AIC8800D80 interface is supported")
    marker = Path("/sys/module/aic8800_fdrv/parameters/openhd_monitor")
    if not marker.exists() or marker.read_text().strip() not in ("Y", "1"):
        parser.error("experimental monitor TX is not compiled in the loaded driver")
    session = os.environ.get("SSH_CONNECTION", "").split()
    if session:
        route = run(["ip", "route", "get", session[0]])
        if re.search(r"\bdev " + re.escape(args.interface) + r"\b", route):
            parser.error("SSH management uses the target Wi-Fi interface; use Ethernet or serial")
    if args.frequency != 5180:
        parser.error("initial board trial is limited to 5180 MHz/HT20; qualify other channels separately")
    phy = run(["iw", "phy"])
    channel = next((line for line in phy.splitlines() if "5180.0 MHz" in line or "5180 MHz" in line), "")
    if not channel or any(flag in channel.lower() for flag in ("disabled", "no ir", "radar")):
        parser.error("5180 MHz is not available for transmission in the current regulatory state")

    def interrupted(_number, _frame):
        # A second signal must not interrupt restoration after the first one.
        for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(number, signal.SIG_IGN)
        raise KeyboardInterrupt

    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(number, interrupted)
    try:
        return with_monitor(args.interface, args.frequency, command)
    except KeyboardInterrupt:
        return 130
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        print(json.dumps({"result": "ERROR", "error": str(error), "wireless_qualified": False}))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
