# SPDX-License-Identifier: MIT
[Unit]
Description=Verify the Q6A XFCE desktop before confirming OTA
Requires=xserver-nodm.service
After=xserver-nodm.service

[Service]
Type=oneshot
User=weston
ExecStart=/usr/bin/qcom-xfce-ready
TimeoutStartSec=125
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
