From: shaohong.dong <shaohong.dong.cq@gmail.com>
Subject: [PATCH] arm64: dts: qcom: correct Dragon Q6A SoundWire port counts

Match controller-reported port counts and extend per-port configuration
without changing the existing WCD938x port mappings. Additional ports
are not used by the board audio routes.

Upstream-Status: Pending
Signed-off-by: shaohong.dong <shaohong.dong.cq@gmail.com>
---
--- a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
+++ b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
@@ -863,6 +863,20 @@
 &swr0 {
 	status = "okay";
 
+	/* Describe all hardware ports; retain existing codec port mappings. */
+	qcom,din-ports = <1>;
+	qcom,dout-ports = <6>;
+	qcom,ports-word-length = /bits/ 8 <0x01 0x07 0x04 0xff 0xff 0xff 0xff>;
+	qcom,ports-sinterval-low = /bits/ 8 <0x03 0x3f 0x1f 0x03 0x03 0xff 0xff>;
+	qcom,ports-offset1 = /bits/ 8 <0x00 0x00 0x0b 0x01 0x01 0xff 0xff>;
+	qcom,ports-offset2 = /bits/ 8 <0x00 0x00 0x0b 0x00 0x00 0xff 0xff>;
+	qcom,ports-lane-control = /bits/ 8 <0x01 0x00 0x00 0x00 0x00 0xff 0xff>;
+	qcom,ports-block-pack-mode = /bits/ 8 <0xff 0x00 0x01 0xff 0xff 0xff 0xff>;
+	qcom,ports-hstart = /bits/ 8 <0xff 0x03 0xff 0xff 0xff 0xff 0xff>;
+	qcom,ports-hstop = /bits/ 8 <0xff 0x06 0xff 0xff 0xff 0xff 0xff>;
+	qcom,ports-block-group-count = /bits/ 8 <0xff 0xff 0xff 0xff 0x00 0xff 0xff>;
+
+
 	wcd_rx: codec@0,4 {
 		compatible = "sdw20217010d00";
 		reg = <0 4>;
@@ -872,6 +886,20 @@
 
 &swr1 {
 	status = "okay";
+
+	/* Describe all hardware ports; retain existing codec port mappings. */
+	qcom,din-ports = <4>;
+	qcom,dout-ports = <0>;
+	qcom,ports-sinterval-low = /bits/ 8 <0x01 0x03 0x03 0xff>;
+	qcom,ports-offset1 = /bits/ 8 <0x01 0x00 0x02 0xff>;
+	qcom,ports-offset2 = /bits/ 8 <0x00 0x00 0x00 0xff>;
+	qcom,ports-hstart = /bits/ 8 <0xff 0xff 0xff 0xff>;
+	qcom,ports-hstop = /bits/ 8 <0xff 0xff 0xff 0xff>;
+	qcom,ports-word-length = /bits/ 8 <0xff 0x00 0xff 0xff>;
+	qcom,ports-block-pack-mode = /bits/ 8 <0xff 0xff 0xff 0xff>;
+	qcom,ports-block-group-count = /bits/ 8 <0xff 0xff 0xff 0xff>;
+	qcom,ports-lane-control = /bits/ 8 <0x00 0x01 0x00 0xff>;
+
 
 	wcd_tx: codec@0,3 {
 		compatible = "sdw20217010d00";
